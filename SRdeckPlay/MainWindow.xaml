<Window x:Class="SRdeckPlay.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:SRdeckPlay"
        Title="SRdeckPlay" Icon="SRdeckPlay.ico" Width="1380" Height="880" MinWidth="1000" MinHeight="720"
        Background="{DynamicResource PanelBaseBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="{DynamicResource MainFontFamily}" FontSize="11" UseLayoutRounding="True"
        AllowDrop="True" Drop="OnDrop" PreviewKeyDown="OnKeyDown" Closing="OnClosing">
    <Window.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource PanelSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="#414141" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="12" />
        </Style>
        <Style TargetType="Button" BasedOn="{StaticResource SRdeckButtonStyle}">
            <Setter Property="Height" Value="19" /><Setter Property="MinWidth" Value="55" />
            <Setter Property="Margin" Value="3" />
        </Style>
        <Style TargetType="TextBox" BasedOn="{StaticResource SRdeckTextBoxStyle}">
            <Setter Property="Height" Value="22" />
            <Setter Property="CaretBrush" Value="{DynamicResource TextPrimaryBrush}" />
        </Style>
    </Window.Resources>
    <Grid Margin="12">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <DockPanel Margin="2,0,2,6">
            <Button DockPanel.Dock="Right" Content="IQ WAVを開く…" Click="OnOpen" MinWidth="145" />
            <StackPanel>
                <TextBlock x:Name="FileText" Text="アナログ狭帯域IQプレーヤー · WAVをドラッグして開く" Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" MaxWidth="800" />
            </StackPanel>
        </DockPanel>
        <Grid Grid.Row="1">
            <Grid.RowDefinitions><RowDefinition Height="*" MinHeight="300" /><RowDefinition Height="10" /><RowDefinition Height="3*" /></Grid.RowDefinitions>
            <Border x:Name="OverviewPanel" Style="{StaticResource Card}" Padding="6">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="14" /></Grid.RowDefinitions>
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <ToggleButton x:Name="ShowDiscontinuityLinesToggle" Content="不連続線" IsChecked="True" Click="OnToggleDropoutLines"
                                      VerticalAlignment="Center" Margin="6,0,8,0" Height="19"
                                      Style="{StaticResource SRdeckToggleButtonStyle}" />
                            <Border Background="{DynamicResource RaisedPanelBrush}" Margin="3,0">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="30" /><ColumnDefinition Width="30" /></Grid.ColumnDefinitions>
                                    <Button Content="−" Click="OnZoomOut" Width="30" Height="19"
                                            Style="{StaticResource LedLeftYellowGreenStepButtonStyle}" />
                                    <Button Grid.Column="1" Content="＋" Click="OnZoomIn" Width="30" Height="19"
                                            Style="{StaticResource LedRightYellowGreenStepButtonStyle}" />
                                </Grid>
                            </Border>
                            <Button x:Name="ShowAllButton" Content="全体" Click="OnShowAll" />
                        </StackPanel>
                        <TextBlock x:Name="OverviewTitle" Text="RECORDING OVERVIEW · 水色: スケルチレベル / 橙: 不連続線" Foreground="{DynamicResource LedYellowGreenBrush}" VerticalAlignment="Center" Margin="6,0,0,0" FontSize="11" TextTrimming="CharacterEllipsis" />
                    </DockPanel>
                    <local:TimelineView x:Name="Timeline" Grid.Row="1" Margin="0,2,0,3" />
                    <ScrollBar x:Name="TimeScroll" Grid.Row="2" Orientation="Horizontal" Minimum="0" Maximum="0" Height="14" ValueChanged="OnScroll" />
                </Grid>
            </Border>
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions><ColumnDefinition Width="380" /><ColumnDefinition Width="10" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Border x:Name="ControlPanel" Style="{StaticResource Card}" Padding="10">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock Text="PLAYBACK / DEMODULATION" Foreground="{DynamicResource LedYellowGreenBrush}" Margin="0,0,0,8" />
                        <TextBlock x:Name="MetadataText" Text="録音情報はファイルを開くと表示されます" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" LineHeight="18" FontSize="11" />
                        <TextBlock x:Name="TimeText" Text="録音時刻なし" FontFamily="{DynamicResource DisplayFontFamily}" FontSize="14" Margin="0,10,0,5" />
                        <TextBlock x:Name="DurationText" Text="" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,6" />
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="PlayButton" Content="▶ 再生" Click="OnPlay" MinWidth="90" IsEnabled="False" />
                            <Button x:Name="PauseButton" Content="Ⅱ 一時停止" Click="OnPause" MinWidth="95" IsEnabled="False" />
                            <Button x:Name="StopButton" Content="■ 停止" Click="OnStop" MinWidth="80" IsEnabled="False" />
                        </StackPanel>
                        <Grid Margin="0,12,0,0" IsEnabled="False" x:Name="SettingsPanel">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <TextBlock Text="復調方式" /><TextBlock Grid.Column="1" Text="同調オフセット (Hz)" Margin="10,0,0,0" />
                            <ComboBox x:Name="ModeBox" Grid.Row="1" SelectedIndex="1" Margin="0,5,0,12" Height="19" SelectionChanged="OnModeChanged" AutomationProperties.Name="復調方式">
                                <ComboBoxItem Content="AM" /><ComboBoxItem Content="FM" /><ComboBoxItem Content="USB" /><ComboBoxItem Content="LSB" />
                            </ComboBox>
                            <TextBox x:Name="TuningBox" Grid.Row="1" Grid.Column="1" Text="0" Margin="10,5,0,12" AutomationProperties.Name="同調オフセット Hz" />
                            <TextBlock Grid.Row="2" Text="IQ下限 (Hz)" /><TextBlock Grid.Row="2" Grid.Column="1" Text="IQ上限 (Hz)" Margin="10,0,0,0" />
                            <TextBox x:Name="LowerBox" Grid.Row="3" Text="-6250" Margin="0,5,0,0" AutomationProperties.Name="IQ通過帯域の下限 Hz" />
                            <TextBox x:Name="UpperBox" Grid.Row="3" Grid.Column="1" Text="6250" Margin="10,5,0,0" AutomationProperties.Name="IQ通過帯域の上限 Hz" />
                            <TextBlock Grid.Row="4" Grid.ColumnSpan="2" Text="dBm換算補正 (dB) · 空欄で録音時の値" Margin="0,10,0,3" FontSize="11" />
                            <TextBox x:Name="CalibrationBox" Grid.Row="5" Grid.ColumnSpan="2" Text="" AutomationProperties.Name="dBm換算補正 dB" />
                            <CheckBox x:Name="SkipPlaybackCheckBox" Grid.Row="6" Grid.ColumnSpan="2" Content="スキップ再生（閉後3秒で次の開く1秒前へ）" IsChecked="True"
                                      Margin="3,10,0,0" Foreground="{DynamicResource TextSecondaryBrush}" />
                            <StackPanel Grid.Row="7" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,8,0,0" VerticalAlignment="Center">
                                <TextBlock Text="スケルチレベル (dBm)" VerticalAlignment="Center" />
                                <TextBox x:Name="SquelchLevelBox" Text="-100" Width="86" Margin="10,0,0,0"
                                         AutomationProperties.Name="スケルチレベル dBm" />
                            </StackPanel>
                            <StackPanel Grid.Row="8" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,8,0,0">
                                <Button x:Name="ApplyButton" Content="適用" Click="OnApply" MinWidth="90" />
                                <Button Content="方式の標準帯域" Click="OnPreset" MinWidth="150" />
                            </StackPanel>
                        </Grid>
                        <TextBlock x:Name="CalibrationText" Text="" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,8,0,0" />
                        <TextBlock Text="不連続位置 · 選択すると移動" FontSize="11" Margin="0,12,0,4" Foreground="{DynamicResource LedYellowGreenBrush}" />
                        <ListBox x:Name="DiscontinuityList" MaxHeight="80" MinHeight="28" SelectionChanged="OnDiscontinuitySelected" FontSize="10" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}" TextWrapping="Wrap" /></DataTemplate></ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock Text="IQ上下限は同調位置を0 Hzとして指定します。&#10;音量・ミュートはWindowsの音量ミキサーで調整できます。" TextWrapping="Wrap" FontSize="11" LineHeight="17" Foreground="{DynamicResource TextDimBrush}" Margin="0,10,0,0" />
                    </StackPanel>
                    </ScrollViewer>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource Card}" Padding="2">
                    <local:LiveSpectrumView x:Name="LiveView" />
                </Border>
            </Grid>
        </Grid>
        <TextBlock x:Name="StatusText" Grid.Row="2" Text="準備完了" Foreground="{DynamicResource TextSecondaryBrush}" Margin="3,12,3,0" TextWrapping="Wrap" />
    </Grid>
</Window>
